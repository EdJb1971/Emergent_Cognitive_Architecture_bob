# Required to start the backend. Do not commit real values to .env.
GEMINI_API_KEY=replace-with-your-gemini-api-key
SECRET_KEY=replace-with-a-long-random-secret
API_KEY=replace-with-a-local-api-key

# Application
APP_NAME=Multi-Agent Cognitive Architecture API
ENVIRONMENT=development
DEBUG_MODE=false
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/app.log

# Gemini models
LLM_PROVIDER=gemini
LLM_MODEL_NAME=models/gemini-2.5-flash-lite
EMBEDDING_MODEL_NAME=models/embedding-001
LLM_MODEL_FOR_RESPONSE_GENERATION=models/gemini-2.5-flash-lite
LLM_MODEL_FOR_MODERATION=models/gemini-2.0-flash-lite
LLM_MAX_CONCURRENCY_PER_MODEL=2
LLM_GLOBAL_MAX_CONCURRENCY=6
LLM_429_BASE_DELAY_SEC=10.0
LLM_429_JITTER_SEC=0.5

# Ollama probe only. Routine routing stays on Gemini until Phase 2.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=

# Local persistence
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION_CYCLES=cognitive_cycles
CHROMA_COLLECTION_PATTERNS=discovered_patterns

# Optional web search integrations
SERPAPI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Attention controller: default is observability-only.
ATTENTION_CONTROLLER_ENABLED=false
ATTENTION_CONTROLLER_SHADOW_MODE=true
SALIENCE_NETWORK_ENABLED=false