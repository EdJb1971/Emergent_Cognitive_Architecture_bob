# Required to start the backend. Do not commit real values to .env.
# GEMINI_API_KEY is only needed when a Gemini-backed provider is selected below.
GEMINI_API_KEY=replace-with-your-gemini-api-key
SECRET_KEY=replace-with-a-long-random-secret
API_KEY=replace-with-a-local-api-key

# Application
APP_NAME=Multi-Agent Cognitive Architecture API
ENVIRONMENT=development
DEBUG_MODE=false
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/app.log

# Provider selection: generation, embeddings, moderation, and final synthesis are chosen independently.
# Each accepts 'gemini' or 'ollama'.
LLM_PROVIDER=gemini
MODERATION_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
# Empty follows LLM_PROVIDER.
SYNTHESIS_PROVIDER=
# Refuse startup when any selected role is remote.
LOCAL_ONLY_MODE=false
LLM_MODEL_NAME=models/gemini-2.5-flash-lite
EMBEDDING_MODEL_NAME=models/embedding-001
LLM_MODEL_FOR_RESPONSE_GENERATION=models/gemini-2.5-flash-lite
LLM_MODEL_FOR_MODERATION=models/gemini-2.0-flash-lite
LLM_MAX_CONCURRENCY_PER_MODEL=2
LLM_GLOBAL_MAX_CONCURRENCY=6
LLM_429_BASE_DELAY_SEC=10.0
LLM_429_JITTER_SEC=0.5

# Local Ollama. Chat and embedding roles are independently selectable above.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=gemma4:e4b
OLLAMA_EMBEDDING_MODEL=embeddinggemma:latest
OLLAMA_MAX_INTERACTIVE_REQUESTS=1
OLLAMA_MAX_BACKGROUND_REQUESTS=1
OLLAMA_NUM_CTX=16384
OLLAMA_THINKING=false

# Bounds concise meta-cognitive routing/uncertainty responses.
META_COGNITIVE_MAX_OUTPUT_TOKENS=64
META_COGNITIVE_MAX_RESPONSE_WORDS=40

# Refuses to open a collection whose stored vectors came from a different embedding model.
EMBEDDING_IDENTITY_ENFORCED=true

# Local persistence
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION_CYCLES=cognitive_cycles
CHROMA_COLLECTION_PATTERNS=discovered_patterns

# External research is fail-closed. Only the disabled provider exists in this slice.
RESEARCH_ENABLED=false
RESEARCH_PROVIDER=disabled
RESEARCH_MODEL=gemini-3.5-flash-lite
RESEARCH_LOW_CONFIDENCE_THRESHOLD=0.55
RESEARCH_MAX_QUERIES=3
RESEARCH_MAX_QUERY_CHARS=500
RESEARCH_TIMEOUT_SECONDS=30

# Cognitive effort allocation runs in observability-only shadow mode first.
COGNITIVE_RESEARCH_DRIVE_ENABLED=false
COGNITIVE_RESEARCH_DRIVE_SHADOW_MODE=true
COGNITIVE_RESEARCH_DEEPEN_THRESHOLD=0.28
COGNITIVE_RESEARCH_UNCERTAINTY_THRESHOLD=0.48
COGNITIVE_RESEARCH_INQUIRY_THRESHOLD=0.64
COGNITIVE_RESEARCH_EXTERNAL_THRESHOLD=0.78
COGNITIVE_RESEARCH_COOLDOWN_MINUTES=30
COGNITIVE_RESEARCH_HYSTERESIS_MINUTES=15

# Durable local queue for waking and dream-generated research needs.
INQUIRY_QUEUE_ENABLED=true
INQUIRY_DB_PATH=./chroma_db/inquiry_queue.sqlite3
INQUIRY_TTL_DAYS=14
INQUIRY_REQUIRE_USER_APPROVAL=true

# Legacy search credentials (unused by ResearchService; retained for migration).
SERPAPI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Attention and salience controllers: disabled by default; shadow mode never changes behavior.
ATTENTION_CONTROLLER_ENABLED=false
ATTENTION_CONTROLLER_SHADOW_MODE=true
SALIENCE_NETWORK_ENABLED=false
SALIENCE_NETWORK_SHADOW_MODE=true
SALIENCE_NETWORK_TOP_K=3
SALIENCE_RECENCY_HALF_LIFE_DAYS=30

# Governed sleep is off until explicitly enabled and requires fully local providers by default.
SLEEP_CYCLE_ENABLED=false
SLEEP_IDLE_MINUTES=30
SLEEP_CHECK_INTERVAL_SECONDS=60
SLEEP_COOLDOWN_MINUTES=360
SLEEP_MAX_CYCLES=20
SLEEP_REQUIRE_LOCAL_PROVIDER=true
SLEEP_LEDGER_DB_PATH=./chroma_db/sleep_cycle.sqlite3

# Unified autonomous-work executive control. Initiative-producing categories
# start off; essential summary/STM housekeeping starts on.
AUTONOMOUS_WORK_MASTER_ENABLED=true
AUTONOMOUS_WORK_DB_PATH=./chroma_db/autonomous_work.sqlite3
AUTONOMOUS_WORK_MAX_CONCURRENT=1
AUTONOMOUS_REFLECTION_ENABLED=false
AUTONOMOUS_DISCOVERY_ENABLED=false
AUTONOMOUS_CURIOSITY_ENABLED=false
AUTONOMOUS_SELF_ASSESSMENT_ENABLED=false
AUTONOMOUS_PROACTIVE_ENABLED=false
AUTONOMOUS_SUMMARY_ENABLED=true
AUTONOMOUS_STM_FLUSH_ENABLED=true
AUTONOMOUS_DEFAULT_TIMEOUT_SECONDS=300
AUTONOMOUS_DEFAULT_MAX_RETRIES=1

# Live operator telemetry is bounded and process-local; ledgers/databases remain authoritative.
TELEMETRY_REPLAY_SIZE=2000
TELEMETRY_SUBSCRIBER_QUEUE_SIZE=256
