# Required to start the backend. Do not commit real values to .env.
# GEMINI_API_KEY is only needed when a Gemini-backed provider is selected below.
GEMINI_API_KEY=replace-with-your-gemini-api-key
SECRET_KEY=replace-with-a-long-random-secret
API_KEY=replace-with-a-local-api-key

# Application
APP_NAME=Multi-Agent Cognitive Architecture API
ENVIRONMENT=development
DEBUG_MODE=false
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/app.log

# Provider selection: generation, embeddings, moderation, and final synthesis are chosen independently.
# Each accepts 'gemini' or 'ollama'.
LLM_PROVIDER=gemini
MODERATION_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
# Empty follows LLM_PROVIDER.
SYNTHESIS_PROVIDER=
# Refuse startup when any selected role is remote.
LOCAL_ONLY_MODE=false
LLM_MODEL_NAME=models/gemini-2.5-flash-lite
EMBEDDING_MODEL_NAME=models/embedding-001
LLM_MODEL_FOR_RESPONSE_GENERATION=models/gemini-2.5-flash-lite
LLM_MODEL_FOR_MODERATION=models/gemini-2.0-flash-lite
LLM_MAX_CONCURRENCY_PER_MODEL=2
LLM_GLOBAL_MAX_CONCURRENCY=6
LLM_429_BASE_DELAY_SEC=10.0
LLM_429_JITTER_SEC=0.5

# Local Ollama. Chat and embedding roles are independently selectable above.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=gemma4:e4b
OLLAMA_EMBEDDING_MODEL=embeddinggemma:latest
OLLAMA_MAX_INTERACTIVE_REQUESTS=1
OLLAMA_MAX_BACKGROUND_REQUESTS=1
OLLAMA_NUM_CTX=16384
OLLAMA_THINKING=false

# Bounds concise meta-cognitive routing/uncertainty responses.
META_COGNITIVE_MAX_OUTPUT_TOKENS=64
META_COGNITIVE_MAX_RESPONSE_WORDS=40

# Refuses to open a collection whose stored vectors came from a different embedding model.
EMBEDDING_IDENTITY_ENFORCED=true

# Local persistence
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION_CYCLES=cognitive_cycles
CHROMA_COLLECTION_PATTERNS=discovered_patterns

# Optional web search integrations
SERPAPI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Attention controller: default is observability-only.
ATTENTION_CONTROLLER_ENABLED=false
ATTENTION_CONTROLLER_SHADOW_MODE=true
SALIENCE_NETWORK_ENABLED=false
